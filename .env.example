# Copy to .env (start.sh does this for you) and adjust. .env is never committed to Git.

# Signs the sign-in cookie. Keep it secret; start.sh fills in a random value.
AOI_SECRET_KEY=

# MongoDB. Local MongoDB (what start.sh starts):
AOI_MONGO_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas instead: paste the connection string from Atlas, for example
# AOI_MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
AOI_MONGO_DB=aoi_labs

# Time zone of the mill (operating hours, order numbers, printed times)
AOI_TIMEZONE=Asia/Bangkok

# Password given to the sample users by "python -m scripts.seed". Change the passwords after the first sign-in.
AOI_SEED_PASSWORD=aoi12345

# 1 = show detailed error pages and reload on code changes (development only)
AOI_DEBUG=0
# 1 = send the sign-in cookie over HTTPS only (turn on for a real deployment)
AOI_COOKIE_SECURE=0

# Automation > AI > "Ask the system": an Anthropic API key (console.anthropic.com). Empty = chat switched off.
# Keep the key secret: it is only read on the server and never shown on screen.
AOI_AI_API_KEY=
AOI_AI_MODEL=claude-sonnet-4-5

# Financial > Market prices: where the market price report comes from, and the daily automatic fetch.
# AOI_MARKET_URL=http://www.thairicemillers.org/index.php?lay=show&ac=article&Ntype=19
AOI_MARKET_AUTO=1
AOI_MARKET_HOUR=9
# NABC daily farm prices (Market prices: source NABC)
# AOI_NABC_PRICE_URL=https://agriapi.nabc.go.th/api/daily-prices/product
# Automation > AI supply indicator (fetched with the market prices once a day)
# AOI_NABC_INDEX_URL=https://agriapi.nabc.go.th/api/production-index-month/sector
